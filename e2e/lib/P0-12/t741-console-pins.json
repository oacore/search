{
  "schema": 1,
  "description": "T-741 console pins (41 T-741; 40 §1 Console; review:ui-flows §8.6): per T-601 200-route and cookie state, the browser console messages of one hard load and of one client route change (e2e/lib/P0-12/routes.mjs changeTargetOf), as counts per message; plus the interaction messages. One set per React/Next version (c2); every message cites R/Q rows (c3). Messages are matched on type and exact text (or `pattern`). Lines Chromium prints for resources the journey guard aborts are not page messages (guard.mjs) and never appear here.",
  "versions": {
    "react-17.0+next-10.2": {
      "recorded": "2026-10-20, parity build 494fc5127f9f9461 (local host mode), Chromium 156 (Playwright 1.64.1)",
      "messages": {
        "ga-search": {
          "type": "warning",
          "text": "Send command doesn't exist: search",
          "cites": ["Q-071", "R-041"],
          "note": "react-ga4 send with hitType 'search' (hooks/use-analytics.js:10-16,33): once per hard load and once per client route change, in every cookie state"
        },
        "ga-log": {
          "type": "log",
          "text": "GA",
          "cites": ["Q-059", "R-041"],
          "note": "console.log(\"GA\") before ReactGA.initialize, with analytics consent only (hooks/use-analytics.js:22)"
        },
        "logrocket-blocked": {
          "type": "warning",
          "text": "LogRocket: script could not load. Check that you have a valid network connection.",
          "cites": ["Q-009", "R-026"],
          "note": "LogRocket.init in render (pages/_app.jsx:90-91); the journey guard aborts and counts the LogRocket CDN (40 §2.4), so the SDK warns once per hard load"
        },
        "katex-convert": {
          "type": "error",
          "pattern": "^couldn`t convert string ",
          "cites": ["Q-097", "S-7"],
          "note": "@oacore/design MathMarkdown latexify logs a KaTeX parse failure and keeps the raw text (lib/elements/math-markdown/utils/latexify.js:29); the recorded climate page 2 holds a title with `\\sb2`"
        },
        "takedown-outputid": {
          "type": "log",
          "pattern": "^Takedown outputId => ",
          "cites": ["Q-036", "R-037"],
          "note": "console.log on every takedown submit (templates/output/update/index.jsx:52)"
        },
        "filters-fetch-error": {
          "type": "error",
          "text": "i: Request for https://api.core.ac.uk/v3/search/works/aggregate failed on 500",
          "cites": ["Q-021", "R-028"],
          "note": "store/filters.js:104 console.error(error) when the E2 aggregation fails (review:ui-flows §8.6 'error from fetchFilters on API failure'); the error is the api/errors.js InternalServerError thrown by api/index.js:80, whose name prints as the minified class name `i`"
        },
        "resource-500": {
          "type": "error",
          "text": "Failed to load resource: the server responded with a status of 500 (Internal Server Error)",
          "cites": ["R-028"],
          "note": "Chromium's own line for a fetch answered 500 (the failing E2 of the aggregation interaction)"
        },
        "claim-response": {
          "type": "log",
          "pattern": "^\\{.*\\}$",
          "cites": ["Q-027", "R-038"],
          "note": "console.log(JSON.stringify(dataProvider)) of the claim POST answer (templates/data-provider/claim/claim-card.jsx:44, marked Debug), once per accepted claim"
        }
