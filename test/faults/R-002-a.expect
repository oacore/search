{
  "schema": 1,
  "fault": "R-002-a",
  "risk": "R-002",
  "mechanism": "the getDataHref patch of pages/_app.jsx is deleted: client navigations request /_next/data/<buildId>/... without the /search prefix",
  "checks": [
    {
      "kind": "request",
      "url": "/search/?q=climate",
      "via": "proxy",
      "js": true,
      "steps": [{ "click": "button:text-is(\"2\")" }],
      "expect": {
        "method": "GET",
        "urlMatches": "^https?://[^/]+/_next/data/[^/]+/search\\.json",
        "min": 1
      }
    },
    {
      "kind": "request",
      "url": "/search/?q=climate",
      "via": "proxy",
      "js": true,
      "steps": [{ "click": "button:text-is(\"2\")" }],
      "expect": {
        "method": "GET",
        "urlMatches": "/search/_next/data/",
        "count": 0
      }
    }
  ]
}
