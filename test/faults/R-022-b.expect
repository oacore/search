{
  "schema": 1,
  "fault": "R-022-b",
  "risk": "R-022",
  "mechanism": "the Dockerfile no longer copies public/design/icons.svg to public/icons.svg after the build, so the sprite the pages point at (/static/search/icons.svg) is not served: every icon 404s and nothing reports it",
  "checks": [
    {
      "kind": "dom",
      "url": "/search/?q=climate",
      "via": "proxy",
      "expect": { "selector": "use[href$=\"#menu\"]", "attribute": "href", "value": "/static/search/icons.svg#menu" }
    },
    {
      "kind": "status",
      "url": "/static/search/icons.svg",
      "via": "proxy",
      "expect": { "status": 404 }
    }
  ]
}
