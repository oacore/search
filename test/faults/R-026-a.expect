{
  "schema": 1,
  "fault": "R-026-a",
  "risk": "R-026",
  "mechanism": "*.logrocket.com is missing from every CSP directive that lists LogRocket hosts",
  "checks": [
    {
      "kind": "header",
      "url": "/search/?q=climate",
      "via": "proxy",
      "expect": { "name": "Content-Security-Policy", "matches": "lgrckt-in\\.com" }
    },
    {
      "kind": "header",
      "url": "/search/?q=climate",
      "via": "proxy",
      "expect": { "name": "Content-Security-Policy", "matches": "^(?!.*logrocket\\.com)" }
    }
  ]
}
