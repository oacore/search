{
  "schema": 1,
  "fault": "R-068-b",
  "risk": "R-068",
  "mechanism": "the production data rewrite /search/_next/data/:path* has the wrong destination (/): the data URL of every client navigation answers 200 text/html and the router falls back to a full page load",
  "checks": [
    {
      "kind": "request",
      "url": "/search/?q=climate",
      "via": "proxy",
      "js": true,
      "steps": [{ "click": "button:text-is(\"2\")" }],
      "expect": {
        "method": "GET",
        "urlMatches": "^https?://[^/]+/search/\\?q=climate&page=2$",
        "min": 1
      }
    }
  ],
  "script": "R-068-b.mjs"
}
