{
  "schema": 1,
  "fault": "R-026-b",
  "risk": "R-026",
  "mechanism": "sentry.io is missing from the connect-src directive",
  "checks": [
    {
      "kind": "header",
      "url": "/search/?q=climate",
      "via": "proxy",
      "expect": { "name": "Content-Security-Policy", "matches": "connect-src [^;]*cloudflareinsights" }
    },
    {
      "kind": "header",
      "url": "/search/?q=climate",
      "via": "proxy",
      "expect": { "name": "Content-Security-Policy", "matches": "^(?!.*connect-src[^;]*sentry\\.io)" }
    }
  ]
}
