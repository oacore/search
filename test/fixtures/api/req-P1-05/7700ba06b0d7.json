            "title": "Carbonated ultramafic igneous rocks in Jezero crater, Mars",
            "language": null,
            "publishedDate": "2026-02-19T00:00:00+00:00",
            "publisher": "The American Association for the Advancement of Science",
            "references": [],
            "sourceFulltextUrls": [
              "https://eprints.bbk.ac.uk/id/eprint/57829/1/Williford%20et%20al.%20%282025%29%20Crater%20margin.pdf",
              "http://doi.org/10.1126/science.adu8264"
            ],
            "updatedDate": null,
