            "title": "Uncertainty in helium diffusion in zircon limits thermochronologic resolution: application to the Great Unconformity",
            "language": null,
            "publishedDate": "2026-08-27T01:00:00+01:00",
            "publisher": "Copernicus Publications",
            "references": [],
            "sourceFulltextUrls": [
              "https://eprints.bbk.ac.uk/id/eprint/57853/1/Fox2026.pdf",
