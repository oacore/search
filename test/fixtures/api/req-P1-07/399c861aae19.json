            "title": "Building Sustainable Professional Development for ECE Practitioners in Low Resource Contexts",
            "language": null,
            "publishedDate": "2027-01-01T00:00:00+00:00",
            "publisher": "Routledge",
            "references": [],
            "sourceFulltextUrls": ["http://dx.doi.org/10.4324/9781003609957-2"],
