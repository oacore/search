  "scripts": {
    "prepare": "husky",
    "dev": "next dev",
    "build": "node ./data/data-loader.js && node ./node_modules/.bin/design build icons && next build",
    "build:test": "node ./node_modules/.bin/design build icons && next build",
    "start": "next start",
    "lint:json": "prettier --ignore-path .gitignore --ignore-path .prettierignore --check '**/*.json'",
    "lint:js": "eslint .",
    "lint:css": "stylelint --ignore-path .gitignore --ignore-path .stylelintignore '**/*.css'",
    "lint:parity": "node scripts/lint-parity.mjs",
    "lint": "run-p lint:*",
    "test:unit": "TZ=UTC jest --selectProjects node dom",
    "test:static": "TZ=UTC jest --selectProjects static",
    "test:ops": "TZ=UTC jest --selectProjects ops",
    "test:harness": "TZ=UTC jest -t T-012 && node e2e/proxy/generate.mjs --self-test && node test/ssr/stub.mjs --self-check",
    "docs:check": "node tools/check-docs.mjs docs/upgrade --repo . --tests test,e2e",
    "fixtures:record": "node scripts/fixtures-record.mjs",
    "fixtures:scrub-check": "node scripts/fixtures-scrub.mjs",
    "fixtures:vf03": "node scripts/fixtures-vf03.mjs",
    "build:parity": "node scripts/build-parity.mjs",
    "e2e:up": "node scripts/e2e-stack.mjs up",
    "e2e": "node scripts/e2e-stack.mjs test",
    "e2e:down": "node scripts/e2e-stack.mjs down",
    "e2e:status": "node scripts/e2e-stack.mjs status",
    "e2e:gc": "node scripts/e2e-stack.mjs gc",
    "e2e:visual": "node scripts/e2e-stack.mjs test --visual",
    "e2e:record": "node scripts/e2e-stack.mjs test --record",
    "corpus": "node scripts/corpus.mjs",
    "corpus:build": "node scripts/corpus-build.mjs",
    "corpus:sanitise": "node scripts/corpus-sanitise.mjs",
    "corpus:record": "node scripts/corpus-record.mjs",
    "soak": "node scripts/soak.mjs",
    "faults": "node scripts/run-faults.mjs",
    "mutation": "stryker run stryker.config.mjs",
    "coverage": "node scripts/merge-coverage.mjs",
    "outdated-at": "node scripts/outdated-at.mjs",
    "test:image": "bash test/ops/t901.sh"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --no-warn-ignored",
      "prettier --write"
    ],
    "*.css": [
      "stylelint",
      "prettier --check"
    ],
    "*.json": "prettier --write"
  }
}
